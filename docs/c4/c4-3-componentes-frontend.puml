' C4 Model - Nivel 3: Diagrama de Componentes
' Contenedor: SPA Web Piedrazul
' Muestra los componentes de la aplicacion frontend
@startuml C4_Componentes_Frontend_Piedrazul
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

!pragma layout elk
skinparam linetype ortho

title C4 Model - Nivel 3: Componentes del contenedor SPA Web Piedrazul

Container_Boundary(spa, "SPA Web Piedrazul", "Vue 3 + Vite") {

    Component(main, "main.js", "Bootstrap", "Inicializa Keycloak (check-sso) y monta la aplicacion.")
    Component(app, "App.vue", "Vue 3 SFC", "Layout, navegacion, indicador de usuario y cierre de sesion.")
    Component(router, "Router", "vue-router", "Rutas y guardas de autenticacion y rol.")
    Component(keycloakAdapter, "keycloak.js", "keycloak-js", "Adaptador OIDC: login, logout, updateToken y tokenParsed.")
    Component(useAuth, "useAuth", "Composable", "Estado reactivo de sesion y roles; helpers isAdmin, isPatient, isProfessional e isScheduler.")

    Component(views, "Vistas", "Vue 3 SFC", "HomeView, LoginView, RegisterView, SpecialtiesView, ProfessionalsView, SchedulingView, AppointmentsView, PatientsView y UsersView.")
    Component(services, "Servicios API", "JavaScript", "authService, userService, patientService, specialtyService, professionalService, schedulingService y appointmentService.")
    Component(axiosClient, "Cliente HTTP", "Axios", "Renueva el token con Keycloak, adjunta Bearer JWT y normaliza errores.")

}

System_Ext(keycloak, "Keycloak", "Realm piedrazul: login OIDC y emision de tokens.")
Container(api, "API REST Piedrazul", "Java 21, Spring Boot 4", "Backend monolito modular que expone los endpoints REST consumidos por la SPA.", $tags="+api")

Rel(main, keycloakAdapter, "Inicializa la sesion (check-sso)")
Rel(main, app, "Monta la aplicacion")
Rel(app, router, "Navega entre vistas")
Rel(app, useAuth, "Usa el estado de autenticacion")
Rel(app, views, "Renderiza la vista de la ruta")
Rel(router, useAuth, "Ejecuta guardas de autenticacion y rol")
Rel(useAuth, services, "Delega login, logout y registro")
Rel(useAuth, keycloakAdapter, "Sincroniza token y eventos de sesion")
Rel(views, services, "Invoca el servicio de su dominio")
Rel(services, axiosClient, "Usa el cliente HTTP")
Rel(services, keycloakAdapter, "authService usa login y logout")
Rel(axiosClient, keycloakAdapter, "updateToken y Bearer JWT")
Rel(keycloakAdapter, keycloak, "Authorization Code + PKCE y refresh token", "OpenID Connect / HTTPS")
Rel(axiosClient, api, "Peticiones HTTP/JSON con Authorization: Bearer JWT", "HTTPS/JSON")

SHOW_LEGEND()
LAYOUT_WITH_LEGEND()

@enduml
