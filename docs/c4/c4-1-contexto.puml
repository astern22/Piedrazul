' C4 Model - Nivel 1: Diagrama de Contexto
' Sistema: Piedrazul - Agendamiento de Citas Medicas
@startuml C4_Contexto_Piedrazul
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

!pragma layout elk
skinparam linetype ortho

title C4 Model - Nivel 1: Diagrama de Contexto del Sistema Piedrazul

Person(paciente, "Paciente", "Usuario que se registra, consulta el catalogo de especialidades y profesionales, y agenda o cancela sus citas medicas.")
Person(profesional, "Profesional de la Salud", "Usuario que gestiona su disponibilidad semanal y consulta sus citas asignadas.")
Person(agendador, "Agendador", "Personal administrativo que agenda, reprograma y consulta citas en nombre de los pacientes.")
Person(administrador, "Administrador", "Usuario encargado de gestionar especialidades, profesionales, agendadores y parametros del sistema.")

System(piedrazul, "Piedrazul", "Sistema web para el agendamiento de citas medicas. Permite gestionar usuarios, pacientes, profesionales, especialidades, disponibilidad semanal y citas.")

System_Ext(keycloak, "Keycloak", "Servidor de identidad y acceso (OpenID Connect). Administra usuarios, credenciales, roles y tokens JWT del realm piedrazul.")

Rel(paciente, piedrazul, "Consulta especialidades y profesionales, agenda y cancela citas", "HTTPS")
Rel(profesional, piedrazul, "Registra su disponibilidad semanal y consulta sus citas", "HTTPS")
Rel(agendador, piedrazul, "Agenda y consulta citas para los pacientes", "HTTPS")
Rel(administrador, piedrazul, "Administra catalogos, cuentas y parametros", "HTTPS")
Rel(piedrazul, keycloak, "Autentica usuarios, valida tokens y administra cuentas", "OpenID Connect / HTTPS")

SHOW_LEGEND()
LAYOUT_WITH_LEGEND()

@enduml
