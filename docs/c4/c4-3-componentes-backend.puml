' C4 Model - Nivel 3: Diagrama de Componentes
' Contenedor: API REST Piedrazul (Monolito Modular)
' Muestra los modulos funcionales que componen el backend
@startuml C4_Componentes_Backend_Piedrazul
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

!pragma layout elk
skinparam linetype ortho

title C4 Model - Nivel 3: Componentes del contenedor API REST Piedrazul

Container_Boundary(api, "API REST Piedrazul", "Java 21, Spring Boot 4") {

    Component(mod_usuarios, "Modulo de Usuarios y Cuentas", "Spring MVC + Spring Security + JPA", "AuthController, UserAdminController, RegisterUserService y SchedulerUserService. Crea el perfil local y la cuenta en Keycloak.")
    Component(mod_pacientes, "Modulo de Pacientes", "Spring MVC + JPA", "PatientController y PatientService. Datos demograficos, /me y vinculo con el usuario.")
    Component(mod_prof, "Modulo de Profesionales y Especialidades", "Spring MVC + JPA", "ProfessionalController, SpecialtyController, ProfessionalService y SpecialtyService. Cuenta PROFESSIONAL en Keycloak.")
    Component(mod_agenda, "Modulo de Agendamiento y Disponibilidad", "Spring MVC + JPA", "WeeklyAvailabilityController, AvailableSlotController y sus servicios de disponibilidad y franjas libres.")
    Component(mod_citas, "Modulo de Citas Medicas", "Spring MVC + JPA", "AppointmentController y AppointmentService. Citas, cancelacion, historial y control de choques de horario.")
    Component(seguridad, "Seguridad Transversal (OAuth2 + Keycloak)", "Spring Security OAuth2 Resource Server", "SecurityConfig, KeycloakJwtAuthenticationConverter, AuthenticatedUserService y KeycloakAdminClient.")

}

System_Ext(keycloak, "Keycloak", "Realm piedrazul: tokens, JWKS y Admin API.")
ContainerDb(db, "Base de Datos Piedrazul", "PostgreSQL 16", "Esquema piedrazul: users, roles, patients, professionals, weekly_availability y appointments.")

Rel(mod_usuarios, mod_pacientes, "Crea o vincula el perfil de paciente", "Spring Beans")
Rel(mod_prof, mod_usuarios, "Crea el perfil de usuario PROFESSIONAL", "Spring Beans")
Rel(mod_citas, mod_pacientes, "Obtiene el paciente y su historial", "Spring Beans")
Rel(mod_citas, mod_prof, "Obtiene el profesional y su especialidad", "Spring Beans")
Rel(mod_agenda, mod_citas, "Consulta citas para calcular franjas libres", "Spring Beans")
Rel(mod_agenda, mod_prof, "Valida el profesional y su intervalo", "Spring Beans")

Rel(mod_usuarios, seguridad, "Delega el alta de cuentas", "Spring Beans")
Rel(mod_prof, seguridad, "Delega el alta de cuentas", "Spring Beans")
Rel(seguridad, keycloak, "Valida tokens (JWKS) y administra cuentas (Admin API)", "OpenID Connect / HTTPS")

Rel(mod_usuarios, db, "Persiste usuarios y roles", "JDBC")
Rel(mod_pacientes, db, "Persiste pacientes", "JDBC")
Rel(mod_prof, db, "Persiste especialidades y profesionales", "JDBC")
Rel(mod_agenda, db, "Persiste disponibilidad semanal", "JDBC")
Rel(mod_citas, db, "Persiste citas", "JDBC")

SHOW_LEGEND()
LAYOUT_WITH_LEGEND()

@enduml
