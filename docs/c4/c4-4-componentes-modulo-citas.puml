' C4 Model - Nivel 3: Diagrama de Componentes
' Componente: Modulo de Citas Medicas (contenedor API REST)
' Estructura interna por capas (presentation, application, domain, infrastructure)
@startuml C4_Componentes_Modulo_Citas_Piedrazul
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

!pragma layout elk
skinparam linetype ortho

title C4 Model - Nivel 3: Componentes del Modulo de Citas Medicas

Container_Boundary(api, "API REST Piedrazul") {

    Component(controller, "AppointmentController", "Spring MVC", "REST /api/appointments. Crear, actualizar, consultar, listar, eliminar, buscar, /me, cancelacion por el paciente e historial por cedula.", $tags="presentation")
    Component(command, "CreateAppointmentCommand", "Java record", "Comando de creacion de cita (patientId, professionalId, appointmentDate, startTime, endTime).", $tags="presentation")
    Component(dtos, "DTOs de citas", "Java records", "AppointmentRequest/Response, CancelAppointmentRequest, PatientAppointmentHistoryResponse y AppointmentHistoryItemResponse.", $tags="presentation")

    Component(apptSvc, "AppointmentService", "Spring @Service", "Reglas de negocio: crea con estado SCHEDULED, valida choques de horario (409), cancela con motivo y consulta historial por cedula.", $tags="application")

    Component(domain, "Appointment", "Clase de dominio", "Entidad de dominio de la cita (patientId, professionalId, appointmentDate, startTime, endTime, status, cancellationReason, createdAt).", $tags="domain")

    Component(apptEntity, "AppointmentEntity", "JPA @Entity", "Tabla appointments. Genera createdAt en @PrePersist y guarda cancellationReason.", $tags="infrastructure")
    Component(apptRepo, "AppointmentRepository", "Spring Data JPA", "findByProfessionalIdAndAppointmentDate, findByPatientId, findByAppointmentDate y findByPatientIdOrderByAppointmentDateDescStartTimeDesc.", $tags="infrastructure")

}

Component(mod_agenda, "Modulo de Agendamiento", "Spring Beans", "Consume AppointmentService.findAppointments para calcular franjas libres.")
Component(patientSvc, "PatientService", "Modulo Pacientes", "Obtiene el paciente de la sesion, su id y los datos del historial.")
Component(profSvc, "ProfessionalService", "Modulo Profesionales", "Obtiene el profesional, su nombre y su especialidad para el historial.")
ContainerDb(db, "Base de Datos Piedrazul", "PostgreSQL 16", "Esquema piedrazul: tabla appointments con indice unico uk_professional_slot.")

Rel(controller, command, "Construye el comando de creacion")
Rel(controller, dtos, "Recibe y construye los DTO de la cita")
Rel(controller, apptSvc, "Delega las operaciones de negocio")

Rel(apptSvc, apptEntity, "Construye y persiste la cita")
Rel(apptSvc, apptRepo, "Consulta, guarda, cancela y elimina citas")
Rel(apptSvc, patientSvc, "Resuelve el paciente de la sesion y su historial", "Spring Beans")
Rel(apptSvc, profSvc, "Completa los datos del profesional y la especialidad", "Spring Beans")

Rel(apptEntity, apptRepo, "Mapeado por JPA")
Rel(apptRepo, db, "SELECT/INSERT/UPDATE/DELETE via JDBC", "JDBC")

Rel_Back(domain, apptEntity, "Modela el agregado de dominio")
Rel(mod_agenda, apptSvc, "Inyecta AppointmentService", "Spring Beans")

SHOW_LEGEND()
LAYOUT_WITH_LEGEND()

@enduml
