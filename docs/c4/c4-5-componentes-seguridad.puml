' C4 Model - Nivel 3: Diagrama de Componentes
' Componente: Seguridad Transversal (OAuth2 + Keycloak) del contenedor API REST
' Infraestructura transversal compartida por todos los modulos
@startuml C4_Componentes_Seguridad_Piedrazul
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

!pragma layout elk
skinparam linetype ortho

title C4 Model - Nivel 3: Componentes de Seguridad Transversal (OAuth2 + Keycloak)

Container_Boundary(api, "API REST Piedrazul") {

    Component(secConfig, "SecurityConfig", "Spring @Configuration", "Resource Server OAuth2: CSRF desactivado, sesiones STATELESS, reglas por rol y JwtDecoder con issuer/JWKS.", $tags="infrastructure")
    Component(converter, "KeycloakJwtAuthenticationConverter", "Spring Security", "Convierte el JWT en Authentication y extrae los roles de realm_access.roles como ROLE_*.", $tags="infrastructure")
    Component(authUser, "AuthenticatedUserService", "Spring @Service", "Expone el sub (keycloakUserId) y preferred_username del usuario autenticado.", $tags="infrastructure")
    Component(keycloakAdmin, "KeycloakAdminClient", "Spring @Component", "Se autentica con client_credentials y crea/elimina usuarios y asigna roles de realm mediante la Admin API.", $tags="infrastructure")

}

System_Ext(keycloak, "Keycloak", "Realm piedrazul: emision de tokens, JWKS y Admin API.")
Component(publicEndpoints, "Endpoints /auth/**", "Modulo Usuarios", "Registro publico de pacientes. El login lo gestiona Keycloak.")
Component(protectedEndpoints, "Endpoints /api/**", "Modulos Pacientes, Profesionales, Agendamiento y Citas", "Rutas protegidas que requieren un JWT valido y el rol adecuado.")
Component(userRepo, "UserRepository", "Modulo Usuarios", "Perfil local vinculado por keycloak_user_id o username.")

Rel(secConfig, keycloak, "Descarga JWKS y valida firma, issuer y vigencia", "OpenID Connect / HTTPS")
Rel(secConfig, converter, "Configura la conversion de JWT a Authentication")
Rel(secConfig, publicEndpoints, "Permite el acceso publico a /auth/**", "URL pattern")
Rel(secConfig, protectedEndpoints, "Exige autenticacion y autoriza por rol", "URL pattern")

Rel(converter, protectedEndpoints, "Publica ROLE_* a partir de realm_access.roles")
Rel(protectedEndpoints, authUser, "Consulta el sub y preferred_username de la sesion")
Rel(authUser, userRepo, "Resuelve el perfil local del usuario", "Spring Beans")

Rel(keycloakAdmin, keycloak, "Crea/elimina usuarios y asigna roles", "Admin API / HTTPS")

note bottom of api
  Los componentes JWT locales anteriores (JwtService,
  JwtAuthenticationFilter y LoginService) ya no participan en
  el flujo: Keycloak emite y valida los tokens.
end note

SHOW_LEGEND()
LAYOUT_WITH_LEGEND()

@enduml
