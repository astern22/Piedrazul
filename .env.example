# Copiar a ".env" (docker compose lo lee automaticamente). Todos los valores son opcionales:
# si no existe el archivo se usan los valores por defecto mostrados aqui (solo para desarrollo).

# URL publica de Keycloak, tal como la ve el navegador.
KEYCLOAK_PUBLIC_URL=http://localhost:8081

# Cuenta de administracion de la consola de Keycloak (http://localhost:8081).
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Contrasena de la base de datos interna de Keycloak.
KEYCLOAK_DB_PASSWORD=keycloak

# Secreto del client "piedrazul-backend" (el backend lo usa para crear usuarios en Keycloak).
BACKEND_CLIENT_SECRET=backend-dev-secret
