# URL base del backend Spring Boot.
# En desarrollo con Vite, dejar en blanco para usar el proxy automatico hacia http://localhost:8080.
# En produccion, configurar la URL del servidor API (ej. https://api.piedrazul.com).
VITE_API_BASE_URL=

# Keycloak (tal como lo ve el navegador). Si no se definen, se usan estos valores por defecto.
VITE_KEYCLOAK_URL=http://localhost:8081
VITE_KEYCLOAK_REALM=piedrazul
VITE_KEYCLOAK_CLIENT_ID=piedrazul-frontend
